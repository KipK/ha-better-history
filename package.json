{
  "name": "ha-better-history",
  "version": "0.1.0",
  "description": "Standalone web component for Home Assistant history charts.",
  "type": "module",
  "author": "@KipK",
  "keywords": [
    "home-assistant",
    "lovelace",
    "web-component",
    "history",
    "chart",
    "lit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KipK/ha-better-history.git"
  },
  "bugs": {
    "url": "https://github.com/KipK/ha-better-history/issues"
  },
  "homepage": "https://github.com/KipK/ha-better-history#readme",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./define": {
      "import": "./dist/define.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": ["dist/define.js"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "vite --config vite.config.dev.ts"
  },
  "dependencies": {
    "@kipk/load-ha-components": "^1.0.3",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^8.0.10"
  }
}
